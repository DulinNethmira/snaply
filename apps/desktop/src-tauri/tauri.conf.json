{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snaply",
  "version": "0.1.1",
  "identifier": "com.snaply.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Snaply",
        "width": 1000,
        "height": 700,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "theme": "Dark"
      }
    ],

    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 https://api.snaply.app https://*.r2.cloudflarestorage.com; img-src 'self' blob: data: http://127.0.0.1:8000 https:; media-src 'self' blob: http://127.0.0.1:8000 https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Snaply",
    "copyright": "Copyright © 2026 Snaply. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Instant screenshot sharing for Windows",
    "longDescription": "Snaply is a lightweight Windows application that lets you capture, annotate, and share screenshots in seconds. Press Ctrl+Shift+S, select an area, and get a shareable link instantly.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Snaply",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1REE5NDU4QzcxNkZCN0YKUldSLyt4YkhXSlRheFVPM2hyTlVGeFVWV0dBei9TeHo5dW9vZ1Q1VW9mcDF3aUNoVU9vZ05kRDkK",
      "endpoints": [
        "https://github.com/DulinNethmira/snaply/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installerArgs": ["/S"]
      }
    }
  }
}
