# Snaply Backend — Local Development Configuration
# ─────────────────────────────────────────────────
# This file is used for local testing only.
# Production credentials are NEVER stored here.
# Copy this file to .env to activate local mode:
#   Copy-Item .env.local .env
# Restore production mode by restoring your production .env.

# Environment identifier
SNAPLY_ENV=development

# Enable API docs and relaxed checks in dev mode
DEBUG=true

# REQUIRED — same key as production or generate a dev one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=257b8136c610b8600c52fae5f0b28961cee832f9cd794f95bc477a48509cb5d2

# SQLite database — stored locally in apps/backend/
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./snaply.db

# ── Storage ──────────────────────────────────────
# Use local filesystem instead of Cloudflare R2
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=data/storage

# ── Resource Limits ───────────────────────────────
MAX_FILE_SIZE_BYTES=104857600
MAX_STORAGE_PER_USER_BYTES=1073741824
MAX_MONTHLY_UPLOADS=500
DEFAULT_EXPIRATION_HOURS=24

# ── CORS ──────────────────────────────────────────
# Allow both Tauri origins and browser localhost for testing
BACKEND_CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost","http://localhost:8000","http://127.0.0.1:8000"]

# ── Cloudflare R2 ─────────────────────────────────
# Leave EMPTY in local mode — do NOT put fake credentials here
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=snaply
