# Snaply Backend Environment Configuration
# Copy to .env and fill in production values

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Set to true for local development (enables /docs, relaxes some checks)
DEBUG=true

SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./snaply.db

# Resource Limits
MAX_FILE_SIZE_BYTES=104857600
MAX_STORAGE_PER_USER_BYTES=1073741824
MAX_MONTHLY_UPLOADS=500
DEFAULT_EXPIRATION_HOURS=24

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","tauri://localhost","https://tauri.localhost"]

# Cloudflare R2 (leave empty for mock mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=snaply
